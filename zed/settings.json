// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  //"vim_mode": true,
  //"relative_line_numbers": "enabled",
  "indent_guides": {
    "background_coloring": "disabled",
  },
  "colorize_brackets": true,
  "lsp_document_colors": "inlay",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Vesper Blur",
  },
  "experimental.theme_overrides": {
    "background": "#101010a9",
    "background.appearance": "transparent",
    "border": "#ffffff24",
    "editor.background": "#00000016",
    "editor.line_number": "#656565",
    "editor.active_line_number": "#FFFFFF",
    "panel.overlay_background": "#1C1C1C",
    "scrollbar.thumb.background": "#ffffff30",
    "scrollbar.track.border": "#ffffff18",
  },
  "toolbar": {
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false,
    "breadcrumbs": false,
  },
  "show_wrap_guides": true,
  "remove_trailing_whitespace_on_save": false,
  "ensure_final_newline_on_save": false,
  "format_on_save": "off",
  "completions": {
    "lsp": true,
  },
  "linked_edits": true,
  "git_panel": {
    "button": false,
  },
  "collaboration_panel": {
    "button": false,
  },
  "outline_panel": {
    "button": false,
  },
  "global_lsp_settings": {
    "button": false,
  },
  "vim": {
    "show_edit_predictions_in_normal_mode": false,
  },
  "show_edit_predictions": false,
  "enable_language_server": true,
  "tabs": {
    "git_status": true,
  },
  "tab_bar": {
    "show_tab_bar_buttons": true,
    "show": true,
  },
  "debugger": {
    "dock": "bottom",
    "button": true,
  },
  "search": {
    "button": true,
  },
  "diagnostics": {
    "lsp_pull_diagnostics": {
      "enabled": true,
    },
    "inline": {
      "enabled": false,
    },
    "button": false,
  },
  "title_bar": {
    "show_menus": false,
    "show_user_menu": true,
    "show_sign_in": true,
    "show_onboarding_banner": false,
    "show_project_items": true,
    "show_branch_name": true,
    "show_branch_status_icon": false,
  },
  "status_bar": {
    "cursor_position_button": false,
    "active_language_button": true,
  },
  "rounded_selection": true,
  "cursor_shape": "bar",
  "cursor_blink": true,
  "agent_ui_font_size": 14.0,
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 400.0,
  "active_pane_modifiers": {
    "border_size": 0.0,
    "inactive_opacity": 1.0,
  },
  "autosave": "on_focus_change",
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "terminal": {
    "button": true,
    "default_height": 420.0,
    "blinking": "terminal_controlled",
    "cursor_shape": "block",
    "font_family": "FiraCode Nerd Font",
    "font_size": 11.0,
    "show_count_badge": false,
  },
  "project_panel": {
    "button": true,
    "default_width": 240.0,
    "git_status_indicator": false,
    "scrollbar": {
      "horizontal_scroll": true,
    },
    "bold_folder_labels": false,
    "git_status": true,
    "folder_icons": false,
    "file_icons": true,
    "hide_gitignore": false,
    "dock": "left",
  },
  "ui_font_family": ".ZedSans",
  "buffer_font_family": ".ZedMono",
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
  },
  "base_keymap": "Cursor",
  "icon_theme": {
    "mode": "dark",
    "light": "Warm Charmed Icons",
    "dark": "Warm Charmed Icons",
  },
  "ui_font_size": 14.0,
  "buffer_font_size": 12.0,
  "git": {
    "git_gutter": "tracked_files", // Shows diff indicators
    "inline_blame": {
      "enabled": false, // Optional: shows git blame inline
    },
  },
  "gutter": {
    "line_numbers": true,
    "runnables": true,
  },
}
